#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // --- Comportamento 1: Segura para Layer 1, Toca para ESCAPE ---
        lh: layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // --- Comportamento 2: Segura para Layer 2, Toca para ESCAPE ---
        lh_bt: layer_hold_bt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // --- Camada 0: Padrão (Híbrida) ---
        default_layer {
            bindings = <
                &lh_bt 2 ESCAPE    &kp LCTRL(Z)    &kp DEL     // <-- CORRIGIDO
                &kp Q              &kp D           &kp RET
                &kp L              &kp F           &lh 1 ESCAPE  // <-- CORRIGIDO
            >;
        };

        // --- Camada 1: Sketch Avançado ---
        layer_1 {
            bindings = <
                &trans          &kp R           &kp T
                &kp O           &kp N           &kp LCTRL(Y)
                &kp F6          &kp E           &trans
            >;
        };

        // --- Camada 2: Bluetooth (Seu layout) ---
        layer_2 {
            bindings = <
                &trans          &none           &bootloader
                &none           &none           &bt BT_CLR
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2
            >;
        };
    };
};
