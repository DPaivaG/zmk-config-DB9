#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // --- Comportamento 1: Segura para Layer 1, Toca para ESCAPE ---
        // O label é "lh" e o node é "lh"
        lh: lh {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            // Segurar = &mo (Momentary layer), Tocar = &kp (Keypress)
            bindings = <&mo>, <&kp>;
        };

        // --- Comportamento 2: Segura para Layer 2, Toca para ESCAPE ---
        // O label é "lh_bt" e o node é "lh_bt"
        lh_bt: lh_bt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            // Segurar = &mo (Momentary layer), Tocar = &kp (Keypress)
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // --- Camada 0: Padrão (Híbrida) ---
        default_layer {
            // Sintaxe Verificada:
            // &lh_bt 2 ESCAPE -> Comportamento (label &lh_bt), Param 1 (layer 2), Param 2 (tecla ESCAPE)
            // &kp LCTRL(Z) -> Tecla modificada (Ctrl + Z)
            // &kp DEL -> Tecla Delete
            bindings = <
                &lh_bt 2 ESCAPE    &kp LCTRL(Z)    &kp DEL
                &kp Q              &kp D           &kp RET     // RET = Enter
                &kp L              &kp F           &lh 1 ESCAPE
            >;
        };

        // --- Camada 1: Sketch Avançado ---
        layer_1 {
            // Sintaxe Verificada:
            // &trans -> Transparente (usa a tecla da camada 0)
            // &kp N -> Tecla N
            // &kp LCTRL(Y) -> Tecla modificada (Ctrl + Y)
            bindings = <
                &trans          &kp R           &kp T
                &kp O           &kp N           &kp LCTRL(Y)
                &kp F6          &kp E           &trans
            >;
        };

        // --- Camada 2: Bluetooth (Seu layout) ---
        layer_2 {
            // Sintaxe Verificada:
            // &bootloader -> Entra no modo bootloader
            // &bt BT_CLR -> Comando Bluetooth "Clear"
            // &bt BT_SEL 0 -> Comando Bluetooth "Select profile 0"
            bindings = <
                &trans          &none           &bootloader
                &none           &none           &bt BT_CLR
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2
            >;
        };
    };
};
